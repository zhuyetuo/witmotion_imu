# 佛山博朗旺狗场 · 电脑2。用法：SITE=佛山博朗旺_狗场2 ./record_multicam.sh
#                         （或 ASCII 别名：SITE=bolangwang2）
#
# 新场地，6 个单间，每间一狗一摄像头，没有公共区那路。两台电脑分：
#     电脑1  1/2/3 号单间  cam1/cam2/cam3 + 项圈 9..14
#     电脑2  4/5/6 号单间  cam4/cam5/cam6 + 项圈 15..20
# 项圈还是老狗场那 12 个（MAC 不变），**狗换了**。老的 sites/狗场*.env 一个字没动。
#
# 跟 sites/狗场1.env 一样按房间分：一只狗的两个轮换项圈都在管它房间的那台上录。
#
# ════════════════════════════════════════════════════════════════════════
# ⚠ 摄像头索引（CAMERAS 第二列）已在现场按预览画面核对（2026-10-26）。
#   换 USB 口就会变，不核对的后果是 5 号间的画面存成 cam4，不报错。重新核对：
#
#        SITE=佛山博朗旺_狗场2 ./record_multicam.sh --probe
#        PREVIEW=1 DEBUG=1 SITE=佛山博朗旺_狗场2 ./record_multicam.sh   # 看画面认房间
#
#    画面上标着 cam4/cam5/cam6，对不上就改第二列的数字。
# ════════════════════════════════════════════════════════════════════════

SITE_ALIAS="bolangwang2"

# ── 摄像头：机位号 → 这台机器上的索引 ────────────────────────────────────
# 第一列是真实机位号，进文件名；两台共用一套号（1..6），传同一个 NAS 目录不撞。
CAMERAS="
4  0   # 4 号单间（2026-10-27 重新核对：摄像头松动后位置变了）
5  2   # 5 号单间
6  1   # 6 号单间
"

# ── 设备：4/5/6 号房间的全部 6 个项圈 ────────────────────────────────────
DEVICES="
15  CE:6E:61:15:B7:6E  quanshi_mu6m    # 拳师犬 6个月 母       4 号单间
16  CB:38:8F:08:6A:5A  quanshi_mu6m    # 拳师犬 6个月 母       4 号单间（轮换的另一个）
17  F7:26:19:3A:AB:6F  kasiluo         # 卡斯罗 8个月 公       5 号单间
18  DC:27:13:E4:42:37  kasiluo         # 卡斯罗 8个月 公       5 号单间（轮换的另一个）
19  E4:A5:52:E8:DC:7E  quanshi_mu7m    # 拳师犬 7个月 母       6 号单间
20  D4:D4:A4:9D:8F:41  quanshi_mu7m    # 拳师犬 7个月 母       6 号单间（轮换的另一个）
"

# 这台不设 DEVICES_STANDBY：两个轮换组都在上面这张表里，一起录。

# ── 配对 ────────────────────────────────────────────────────────────────
# 一路只配它那间的两个项圈。
PAIRS="cam4:imu15 cam4:imu16 \
       cam5:imu17 cam5:imu18 \
       cam6:imu19 cam6:imu20"

# 归档传 NAS：每路摄像头点一次视频；轮换的第二个项圈只点 :csv（同一段画面不传两遍）。
KEEP_PAIRS="cam4_imu15 cam5_imu17 cam6_imu19 \
            cam4_imu16:csv cam5_imu18:csv cam6_imu20:csv"

# 跟老狗场（_gouchang）分开目录，两台写同一个：2026_10_26_bolangwang。
# 只用字母——平台（imu_train 的 _SITE_RE）从目录名里认场地，只认 _[a-z]+。
DAY_SUFFIX="_bolangwang"

# 没有公共区那路，清理脚本不去找 cam7。
SHARED_CAM="none"

CAPTURE_WIDTH="1280"
CAPTURE_HEIGHT="720"
EXTRA_ARGS="--no-save-overlay"
WARMUP_SEC="45"
OUT_DIR="data/multicam_multiimu"

# 影棚。用法：SITE=影棚 ./record_multicam.sh
#
# 设备一律用 MAC 指定，不用名字。名字是子串匹配，设备编号涨到两位数之后
# WT1 会同时命中 WT1 和 WT10（见 ble_utils.match_by_name）；MAC 是精确的，
# 而且设备改名也不影响。名字写在注释里给人看。
#
# 影棚 8 个设备、4 只狗，每只狗两个轮换充电。下面这组是"当班"的四个，
# 换班时把 IMUS 里对应那一项换成备用那个（同一行注释里写着）。
#
# ⚠ IMUS 的顺序决定文件名里的 imu1/imu2/imu3/imu4，别随便调换顺序——
#   调了顺序就等于把数据记到别的狗名下。换设备只换 MAC，位置不动。

# imu1 = bibi   当班 WT1  D1:FD:A8:C7:1A:EF   备用 WT2  EE:96:8A:A4:C6:2A
# imu2 = bali   当班 WT5  F0:76:DC:BE:E2:CA   备用 WT6  D5:34:E2:B9:6F:32
# imu3 = lulu   当班 WT8  D9:01:5C:F2:48:E5   备用 WT7  （MAC 待补，扫描时没见到）
# imu4 = xima   当班 WT3  C0:05:B7:EF:26:32   备用 WT4  E5:F9:02:82:B8:E4
IMUS="wit=D1:FD:A8:C7:1A:EF wit=F0:76:DC:BE:E2:CA wit=D9:01:5C:F2:48:E5 wit=C0:05:B7:EF:26:32"
DOG_NAMES="bibi bali lulu xima"

# 影棚 3 路摄像头
CAMS="0 1 2"

# 这里故意不设 PAIRS：影棚是一个大空间、3 个摄像头都可能拍到 4 只狗中的任意
# 一只，哪路摄像头拍到哪只狗事先不知道，所以全排列（3x4=12 对）是有意义的。
# 狗场那种一间一狗一摄像头的场地才需要设 PAIRS 限制。

# 归档时要传 NAS 的配对（daily_archive.sh 读这个）
KEEP_PAIRS="cam1_imu1 cam2_imu2 cam3_imu3 cam1_imu4:csv"

OUT_DIR="data/multicam_multiimu"

# 佛山博朗旺狗场 · 电脑3（户外活动区）。用法：SITE=佛山博朗旺_狗场3 ./record_multicam.sh
#                                      （或 ASCII 别名：SITE=bolangwang3）
#
# 户外是一块围起来的空地，3 路摄像头拍整片场地；**12 个项圈全写上，连得上哪个录哪个**。
#
# 为什么 12 个全写：每只狗两个项圈轮换，一个戴在身上（狗在户外）、一个在另一间屋子里充电。
# 充电那 6 个这台多半够不着、或者已经被电脑1/2 连着，就连不上——连不上的整段没数据，
# 采集程序不会给它生成配对文件，也就不传，不会多出空样本。实际录到的就是户外戴着的那几个。
# 哪个是戴着的事先不知道（换班随时换），所以不挑，全写上。
#
# ⚠ 一个项圈同一时间只能被一台电脑连上。狗在户外时，它的项圈谁先连上算谁的：
#   这台离得近通常是这台；狗回单间后这台连不上了，电脑1/2 会重新连回去（它们一直在重试）。
#   所以同一个项圈一天的数据会分在两台电脑上，平台按时间各成样本，不冲突。
#   切换的那几十秒到几分钟会丢数据。
#
# ⚠ 12 个同时在连，普通蓝牙适配器可能吃不消（一般稳稳 6~7 个）。实际同时连上的大约 6 个，
#   应该够；现场先跑一次：SITE=佛山博朗旺_狗场3 ./check_ble_capacity.sh --duration 600
#   看连上的那几个是不是都在 50Hz 左右。不够就再插一个 USB 蓝牙适配器。
#
# 摄像头：现在现场只接了 1 路（cam7）。另外两路接回来时去掉 CAMERAS 里那两行的 #。
#
# 默认只录像（见下面 VIDEO_ONLY 的说明）。临时连项圈：
#     VIDEO_ONLY=0 SITE=佛山博朗旺_狗场3 ./record_multicam.sh
#
#     电脑1  1/2/3 号单间  cam1/cam2/cam3 + 项圈 9..14
#     电脑2  4/5/6 号单间  cam4/cam5/cam6 + 项圈 15..20
#     电脑3  户外活动区    cam7/cam8/cam9（只录像）
#
# 传 NAS 的文件：每路一份不带 imu 号的 {base}_cam7_raw.mp4 / cam8 / cam9（拍全场，所有狗共用），
# 加每个连上的项圈一份 {base}_cam7_imuN_raw.csv。视频只传一份，不按项圈复制。
# 平台导入时，这一场每只狗的样本都挂这三路（户外·cam7/8/9）。
# 写进跟电脑1/2 同一个日期目录（2026_11_11_bolangwang），三台的机位号不重复，不撞。
#
# ════════════════════════════════════════════════════════════════════════
# ⚠ 摄像头索引（CAMERAS 第二列）还**没在现场核对**，下面的 0/1/2 是占位。
#   插好摄像头后先跑：
#
#        SITE=佛山博朗旺_狗场3 ./record_multicam.sh --probe        # 看这台认到几路、索引是几
#        PREVIEW=1 DEBUG=1 SITE=佛山博朗旺_狗场3 ./record_multicam.sh   # 看画面认是哪个角度
#
#   画面上标着 cam7/cam8/cam9，对不上就改第二列的数字。换 USB 口就会变。
# ════════════════════════════════════════════════════════════════════════

SITE_ALIAS="bolangwang3"

# "1" = 只录像（下面的项圈这次不连）；命令行 VIDEO_ONLY=1 / VIDEO_ONLY=0 能临时盖过
#
# 2026-11-13 改成默认只录像：项圈交给狗舍里的电脑1/2 收（它们「12 个全采」，戴着的 + 充电的都连）。
# 户外这台也连的话会跟它们抢——一个项圈同一时间只能被一台连上，户外这台抢走了，电脑1/2 就连不上，
# 而且狗回屋以后它也不放手（充电那组放在屋里，也被它连走过，三台都听不到那 6 个）。
# 想临时让它也连项圈：VIDEO_ONLY=0 SITE=佛山博朗旺_狗场3 ./record_multicam.sh
VIDEO_ONLY="1"

# ── 摄像头：机位号 → 这台机器上的索引 ────────────────────────────────────
# 机位号接着电脑1/2 往下编（1..6 是单间），7/8/9 是户外。现场核对后在注释里写清楚哪路拍哪个角
# 2026-11-13 现场只接了 1 路摄像头（cam7，设备 0）。另外两路接回来时把下面两行的 # 去掉
CAMERAS="
7  0   # 户外 · 角度一
# 8  1   # 户外 · 角度二（倒装，见 ROTATE）
# 9  2   # 户外 · 角度三
"

# 连项圈录（默认）时只开 1 路：1 路摄像头 + 12 路蓝牙。只录像（VIDEO_ONLY=1）才开上面全部 3 路。
# 想换成哪一路就改这里（机位号和索引要跟上面 CAMERAS 对应的那一行一致）
CAMERAS_IMU="
7  0   # 户外 · 角度一
"

# ── 设备：全部 12 个项圈（电脑1 的 9..14 + 电脑2 的 15..20），连得上哪个录哪个 ──
DEVICES="
9   DC:32:39:07:0A:3D  dongde          # 东德牧羊犬 3岁半 公   1 号单间
10  CF:FA:72:BE:48:76  dongde          # 东德牧羊犬 3岁半 公   1 号单间（轮换的另一个）
11  CB:DC:DC:40:3D:D1  labuladuo       # 拉布拉多 1岁半 母     2 号单间
12  E0:33:21:2C:4B:C2  labuladuo       # 拉布拉多 1岁半 母     2 号单间（轮换的另一个）
13  EF:8A:A6:65:3A:BC  quanshi_gong7m  # 拳师犬 7个月 公       3 号单间
14  DD:CB:D4:26:F9:55  quanshi_gong7m  # 拳师犬 7个月 公       3 号单间（轮换的另一个）
15  CE:6E:61:15:B7:6E  quanshi_mu6m    # 拳师犬 6个月 母       4 号单间
16  CB:38:8F:08:6A:5A  quanshi_mu6m    # 拳师犬 6个月 母       4 号单间（轮换的另一个）
17  F7:26:19:3A:AB:6F  kasiluo         # 卡斯罗 8个月 公       5 号单间
18  DC:27:13:E4:42:37  kasiluo         # 卡斯罗 8个月 公       5 号单间（轮换的另一个）
19  E4:A5:52:E8:DC:7E  quanshi_mu7m    # 拳师犬 7个月 母       6 号单间
20  D4:D4:A4:9D:8F:41  quanshi_mu7m    # 拳师犬 7个月 母       6 号单间（轮换的另一个）
"

# ── 配对：每个项圈只配 cam7（只为了让每个项圈出一份 cam7_imuN_raw.csv；视频传的是不带 imu 号那份）──
PAIRS="cam7:imu9 cam7:imu10 cam7:imu11 cam7:imu12 cam7:imu13 cam7:imu14 \
       cam7:imu15 cam7:imu16 cam7:imu17 cam7:imu18 cam7:imu19 cam7:imu20"

# 归档传 NAS：三路视频各一份 + 每个项圈的 CSV（:csv 只传 CSV，配对的 mp4 是同一段视频不重复传）
KEEP_PAIRS="cam7_raw:mp4 cam8_raw:mp4 cam9_raw:mp4 \
            cam7_imu9:csv cam7_imu10:csv cam7_imu11:csv cam7_imu12:csv cam7_imu13:csv cam7_imu14:csv \
            cam7_imu15:csv cam7_imu16:csv cam7_imu17:csv cam7_imu18:csv cam7_imu19:csv cam7_imu20:csv"

# 第二路（cam8）是倒着装的，转 180 度。录下来的视频也是转正的（连项圈只开 cam7 时这条自动不用）
# ROTATE="cam8:180"      # cam8 接回来时一起打开

# 跟电脑1/2 同一个日期目录：2026_11_11_bolangwang
DAY_SUFFIX="_bolangwang"

# 没有「公共区那一路」的配对要收拢（那条规则是给老狗场 cam7 天花板用的）
SHARED_CAM="none"

CAPTURE_WIDTH="1280"
CAPTURE_HEIGHT="720"
# --no-precheck：这台不做开录前的「每只狗至少扫到一个项圈」预检。
# 预检是给单间那两台的（漏了一只狗就该拦）；户外这台本来就是连得上哪个录哪个——
# 狗都在屋里时一个都扫不到也正常，照样得开录拍视频。录起来之后项圈照常自动重连。
EXTRA_ARGS="--no-save-overlay --no-precheck"
# 监控墙默认开：3 路户外画面拼在一个窗口里，一眼看全场；点一格放大、再点还原。
# 不影响录像（录下来的还是每路各自的原尺寸）。临时不要就 WALL=0 SITE=佛山博朗旺_狗场3 ./record_multicam.sh
WALL="1"

WARMUP_SEC="45"
OUT_DIR="data/multicam_multiimu"

# 不自动禁用 / 启用蓝牙适配器（远程管理：复位到一半出岔子适配器就停在「已禁用」，人不在现场恢复不了）。
# 有项圈在收数据时本来也不会复位；这里连「一个都连不上」那种也不复位，真坏了宁可报出来等人处理。
# 命令行 BT_RESET=1 可以临时打开
export BT_RESET="${BT_RESET:-0}"

# 传 NAS 限速（daily_archive.sh）：录制不停、一边传一天 30GB，全速 8 路一起传会把网卡吃满，
# WiFi / 蓝牙一体的适配器蓝牙跟着掉。2 路 + 每 64KB 歇 10ms ≈ 最多 10MB/s 上下，30GB 大约 1 小时左右传完
ARCHIVE_MT="${ARCHIVE_MT:-2}"
ARCHIVE_IPG="${ARCHIVE_IPG:-10}"

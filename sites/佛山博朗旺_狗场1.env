# 佛山博朗旺狗场 · 电脑1。用法：SITE=佛山博朗旺_狗场1 ./record_multicam.sh
#                         （或 ASCII 别名：SITE=bolangwang1）
#
# 新场地，6 个单间，每间一狗一摄像头，没有公共区那路。两台电脑分：
#     电脑1  1/2/3 号单间  cam1/cam2/cam3 + 项圈 9..14
#     电脑2  4/5/6 号单间  cam4/cam5/cam6 + 项圈 15..20
# 项圈还是老狗场那 12 个（MAC 不变），**狗换了**。老的 sites/狗场*.env 一个字没动。
#
# 跟 sites/狗场1.env 一样按房间分：一只狗的两个轮换项圈都在管它房间的那台上录。
#
# ════════════════════════════════════════════════════════════════════════
# ⚠ 摄像头索引（CAMERAS 第二列）已在现场按预览画面核对（2026-10-26）。
#   换 USB 口就会变，不核对的后果是 2 号间的画面存成 cam1，不报错。重新核对：
#
#        SITE=佛山博朗旺_狗场1 ./record_multicam.sh --probe
#        PREVIEW=1 DEBUG=1 SITE=佛山博朗旺_狗场1 ./record_multicam.sh   # 看画面认房间
#
#    画面上标着 cam1/cam2/cam3，对不上就改第二列的数字。
# ════════════════════════════════════════════════════════════════════════

SITE_ALIAS="bolangwang1"

# ── 摄像头：机位号 → 这台机器上的索引 ────────────────────────────────────
# 第一列是真实机位号，进文件名；两台共用一套号（1..6），传同一个 NAS 目录不撞。
CAMERAS="
1  2   # 1 号单间（预览里原来标成 cam3 的那路）
2  0   # 2 号单间（原 cam1）
3  1   # 3 号单间（原 cam2）
"

# ── 设备：1/2/3 号房间的全部 6 个项圈 ────────────────────────────────────
DEVICES="
9   DC:32:39:07:0A:3D  dongde          # 东德牧羊犬 3岁半 公   1 号单间
10  CF:FA:72:BE:48:76  dongde          # 东德牧羊犬 3岁半 公   1 号单间（轮换的另一个）
11  CB:DC:DC:40:3D:D1  labuladuo       # 拉布拉多 1岁半 母     2 号单间
12  E0:33:21:2C:4B:C2  labuladuo       # 拉布拉多 1岁半 母     2 号单间（轮换的另一个）
13  EF:8A:A6:65:3A:BC  quanshi_gong7m  # 拳师犬 7个月 公       3 号单间
14  DD:CB:D4:26:F9:55  quanshi_gong7m  # 拳师犬 7个月 公       3 号单间（轮换的另一个）
"

# 这台不设 DEVICES_STANDBY：两个轮换组都在上面这张表里，一起录。

# ── 配对 ────────────────────────────────────────────────────────────────
# 一路只配它那间的两个项圈。
PAIRS="cam1:imu9 cam1:imu10 \
       cam2:imu11 cam2:imu12 \
       cam3:imu13 cam3:imu14"

# 归档传 NAS：每路摄像头点一次视频；轮换的第二个项圈只点 :csv（同一段画面不传两遍）。
KEEP_PAIRS="cam1_imu9 cam2_imu11 cam3_imu13 \
            cam1_imu10:csv cam2_imu12:csv cam3_imu14:csv"

# 跟老狗场（_gouchang）分开目录，两台写同一个：2026_10_26_bolangwang。
# 只用字母——平台（imu_train 的 _SITE_RE）从目录名里认场地，只认 _[a-z]+。
DAY_SUFFIX="_bolangwang"

# 没有公共区那路，清理脚本不去找 cam7。
SHARED_CAM="none"

CAPTURE_WIDTH="1280"
CAPTURE_HEIGHT="720"
EXTRA_ARGS="--no-save-overlay"
WARMUP_SEC="45"
OUT_DIR="data/multicam_multiimu"

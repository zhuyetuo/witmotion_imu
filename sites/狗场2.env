# 狗场电脑2。用法：SITE=狗场2 ./record_multicam.sh
#
# 狗场从一台电脑拆成两台。这台负责 4/5/6 号单间 + 7 号公共区（天花板）的
# 摄像头，加那三间六个项圈（每只狗两个，轮换充电，两个都在这台上录）。
# 原来那份 sites/狗场.env **一个字没动**。
#
# ════════════════════════════════════════════════════════════════════════
# ⚠ 开录之前必须做的一件事：核对摄像头索引
#
# 下面 CAMERAS 第二列是**这台机器上**的枚举索引，老的 sites/狗场.env 里那串
# "4 0 3 5 2 1 6" 是另一台机器的结果，换机器、换 USB 口就会变，照抄必错。
#
#     SITE=狗场2 ./record_multicam.sh --probe
#     PREVIEW=1 DEBUG=1 SITE=狗场2 ./record_multicam.sh   # 看画面认房间
#
# 画面上每一路都标着 cam4/cam5/cam6/cam7，对不上就改第二列。
# **cam7 是天花板那路**，画面是倒的（下面 ROTATE 会转回来），最好认。
# ════════════════════════════════════════════════════════════════════════

SITE_ALIAS="gouchang2"

# ── 摄像头：机位号 → 这台机器上的索引 ────────────────────────────────────
# 第一列是**真实机位号**，进文件名。这台只开 4 路，但号是 4/5/6/7 —— 不是
# cam1..cam4。按位置排的话会跟电脑1 的 cam1 撞车，两台传到同一个 NAS 目录
# 就再也分不出哪个 cam1 是哪个房间了。
CAMERAS="
4  0   # 4 号单间
5  1   # 5 号单间
6  2   # 6 号单间
7  3   # 7 号公共区（天花板，倒装）
"

# 天花板那路倒装，转回来。转在采集这一步，录进视频的就是转好的。
ROTATE="cam7:180"

# ── 设备：4/5/6 号房间的全部 6 个项圈 ────────────────────────────────────
#
# **按房间分，不按单双号分。** 每只狗两个项圈轮换充电（15/16 都是旺财的），
# 两个都归这台机器管，所以不管它今天戴哪一个，都有 4 号单间的画面配着。
# 理由见 sites/狗场1.env 里同一段。
DEVICES="
15  CE:6E:61:15:B7:6E  wangcai      # 旺财 法斗        4 号单间
16  CB:38:8F:08:6A:5A  wangcai      # 旺财 法斗        4 号单间（轮换的另一个）
17  F7:26:19:3A:AB:6F  dajinmao     # 大金毛 金毛      5 号单间
18  DC:27:13:E4:42:37  dajinmao     # 大金毛 金毛      5 号单间（轮换的另一个）
19  E4:A5:52:E8:DC:7E  dongde       # 东德            6 号单间
20  D4:D4:A4:9D:8F:41  dongde       # 东德            6 号单间（轮换的另一个）
"

# 这台不设 DEVICES_STANDBY：两个轮换组都在上面这张表里，一起录。

# ── 配对 ────────────────────────────────────────────────────────────────
# 房间那路只配它那间的两个项圈；公共区（天花板）一路能看到所有狗，所以配全部六个。
PAIRS="cam4:imu15 cam4:imu16 \
       cam5:imu17 cam5:imu18 \
       cam6:imu19 cam6:imu20 \
       cam7:imu15 cam7:imu16 cam7:imu17 cam7:imu18 cam7:imu19 cam7:imu20"

# 房间那三路各点一次视频，轮换的第二个项圈只点 :csv（同一路的同一段画面，
# 点成完整配对就要往 NAS 传两遍）。公共区沿用老 sites/狗场.env 的写法，
# 六个配对都点——cleanup 会把它们收成不带 imu 号的那一份 cam7_raw.mp4。
KEEP_PAIRS="cam4_imu15 cam5_imu17 cam6_imu19 \
            cam4_imu16:csv cam5_imu18:csv cam6_imu20:csv \
            cam7_imu15 cam7_imu16 cam7_imu17 cam7_imu18 cam7_imu19 cam7_imu20"

# 跟电脑1 写同一个日期目录，见 sites/狗场1.env 里的说明。
DAY_SUFFIX="_gouchang"

# 公用机位号（cleanup_gouchang.sh 读这个，不用每次手敲 --shared-cam）。
# 天花板那路，六只狗共用。清理时只留不带 imu 号的那一份。
SHARED_CAM="7"

CAPTURE_WIDTH="1280"
CAPTURE_HEIGHT="720"
EXTRA_ARGS="--no-save-overlay"
WARMUP_SEC="45"
OUT_DIR="data/multicam_multiimu"

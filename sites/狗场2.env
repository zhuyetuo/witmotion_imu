# 狗场电脑2。用法：SITE=狗场2 ./record_multicam.sh
#
# 狗场从一台电脑拆成两台。这台负责 4/5/6 号单间 + 7 号公共区（天花板）的
# 摄像头，加偶数那组设备。原来那份 sites/狗场.env **一个字没动**。
#
# ════════════════════════════════════════════════════════════════════════
# ⚠ 开录之前必须做的一件事：核对摄像头索引
#
# 下面 CAMERAS 第二列是**这台机器上**的枚举索引，老的 sites/狗场.env 里那串
# "4 0 3 5 2 1 6" 是另一台机器的结果，换机器、换 USB 口就会变，照抄必错。
#
#     SITE=狗场2 ./record_multicam.sh --probe
#     PREVIEW=1 DEBUG=1 SITE=狗场2 ./record_multicam.sh   # 看画面认房间
#
# 画面上每一路都标着 cam4/cam5/cam6/cam7，对不上就改第二列。
# **cam7 是天花板那路**，画面是倒的（下面 ROTATE 会转回来），最好认。
# ════════════════════════════════════════════════════════════════════════

SITE_ALIAS="gouchang2"

# ── 摄像头：机位号 → 这台机器上的索引 ────────────────────────────────────
# 第一列是**真实机位号**，进文件名。这台只开 4 路，但号是 4/5/6/7 —— 不是
# cam1..cam4。按位置排的话会跟电脑1 的 cam1 撞车，两台传到同一个 NAS 目录
# 就再也分不出哪个 cam1 是哪个房间了。
CAMERAS="
4  0   # 4 号单间
5  1   # 5 号单间
6  2   # 6 号单间
7  3   # 7 号公共区（天花板，倒装）
"

# 天花板那路倒装，转回来。转在采集这一步，录进视频的就是转好的。
ROTATE="cam7:180"

# ── 设备：偶数那组（跟 sites/狗场.env 的 DEVICES_STANDBY 完全一致）──────
#
# ⚠ 这台有 4/5/6 号单间的摄像头，而偶数组里 10/12/14 是 1/2/3 号单间的狗。
#   那三只在这台机器上只有 IMU + 公共区画面，没有自己房间的画面（房间摄像头
#   在电脑1 上，但电脑1 录的是它们的奇数号项圈）。也就是说：**一只狗今天有没有
#   自己房间的视频，取决于它今天戴的是单号还是双号项圈。**
#
#   想让每只狗每天都有，就按房间分而不是按单双号分——这台拿 4/5/6 号房间的
#   全部 6 个项圈：
#
#     DEVICES="
#     15  CE:6E:61:15:B7:6E  wangcai      # 旺财 法斗      4 号单间
#     16  CB:38:8F:08:6A:5A  wangcai      # 旺财 法斗      4 号单间（另一个）
#     17  F7:26:19:3A:AB:6F  dajinmao     # 大金毛        5 号单间
#     18  DC:27:13:E4:42:37  dajinmao     # 大金毛        5 号单间（另一个）
#     19  E4:A5:52:E8:DC:7E  dongde       # 东德          6 号单间
#     20  D4:D4:A4:9D:8F:41  dongde       # 东德          6 号单间（另一个）
#     "
#   换的话记得连 PAIRS / KEEP_PAIRS 一起换。
DEVICES="
10  CF:FA:72:BE:48:76  xiaobai      # 小白 比熊        1 号单间（房间视频在电脑1）
12  E0:33:21:2C:4B:C2  keji         # 流浪柯基         2 号单间（房间视频在电脑1）
14  DD:CB:D4:26:F9:55  xiaojinmao   # 流浪小金毛 金毛   3 号单间（房间视频在电脑1）
16  CB:38:8F:08:6A:5A  wangcai      # 旺财 法斗        4 号单间
18  DC:27:13:E4:42:37  dajinmao     # 大金毛 金毛      5 号单间
20  D4:D4:A4:9D:8F:41  dongde       # 东德            6 号单间
"

# ── 配对 ────────────────────────────────────────────────────────────────
# 自己房间那三条 + 公共区配全部六只（公共区一路画面能看到所有狗，所以全配）。
# 10/12/14 没有对应机位，不写房间配对，但有公共区的。
PAIRS="cam4:imu16 cam5:imu18 cam6:imu20 \
       cam7:imu10 cam7:imu12 cam7:imu14 cam7:imu16 cam7:imu18 cam7:imu20"

KEEP_PAIRS="cam4_imu16 cam5_imu18 cam6_imu20 \
            cam7_imu10 cam7_imu12 cam7_imu14 cam7_imu16 cam7_imu18 cam7_imu20"

# 跟电脑1 写同一个日期目录，见 sites/狗场1.env 里的说明。
DAY_SUFFIX="_gouchang"

# 公用机位号（cleanup_gouchang.sh 读这个，不用每次手敲 --shared-cam）。
# 天花板那路，六只狗共用。清理时只留不带 imu 号的那一份。
SHARED_CAM="7"

CAPTURE_WIDTH="1280"
CAPTURE_HEIGHT="720"
EXTRA_ARGS="--no-save-overlay"
WARMUP_SEC="45"
OUT_DIR="data/multicam_multiimu"

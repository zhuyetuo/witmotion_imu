# 狗场电脑1。用法：SITE=狗场1 ./record_multicam.sh
#
# 狗场从一台电脑拆成两台。这台负责 1/2/3 号单间的摄像头 + 奇数那组设备。
# 原来那份 sites/狗场.env **一个字没动**，一台机器录七路的老跑法随时能用。
#
# ════════════════════════════════════════════════════════════════════════
# ⚠ 开录之前必须做的一件事：核对摄像头索引
#
# 下面 CAMERAS 第二列是**这台机器上**的 /dev/video 索引（Windows 上是
# DirectShow 的枚举序号）。老的 sites/狗场.env 里那串 "4 0 3 5 2 1 6" 是**另一台
# 机器**上的枚举结果，换台机器、换个 USB 口就会变，照抄必错。
#
# 这里先按 0/1/2 填着。开录前先核对一次：
#
#     SITE=狗场1 ./record_multicam.sh --probe
#     PREVIEW=1 DEBUG=1 SITE=狗场1 ./record_multicam.sh   # 看画面认房间
#
# 画面上每一路都标着 cam1/cam2/cam3，对不上就改下面第二列的数字。
# 核对一次就好，之后除非重插 USB。
#
# 不核对的后果：不会报错，录一整天，然后 2 号房间的画面存成了 cam1——
# 平台按 camN 判房间，从此 A 房间的狗配着 B 房间的画面。跟设备编号按位置排
# 那个坑一模一样（那次是 imu2 里装着 5 号设备的数据）。
# ════════════════════════════════════════════════════════════════════════

SITE_ALIAS="gouchang1"

# ── 摄像头：机位号 → 这台机器上的索引 ────────────────────────────────────
# 第一列是**真实机位号**，进文件名（cam1_imu9_raw.mp4）。两台电脑共用一套
# 机位号，所以传到同一个 NAS 目录也不会撞——cam4 永远是 4 号单间，
# 不管它是哪台机器上的第几路。
CAMERAS="
1  0   # 1 号单间
2  1   # 2 号单间
3  2   # 3 号单间
"

# ── 设备：奇数那组（跟 sites/狗场.env 的 DEVICES 完全一致）──────────────
#
# ⚠ 这台只有 1/2/3 号单间的摄像头，而奇数组里 15/17/19 是 4/5/6 号单间的狗。
#   那三只在这台机器上**只有 IMU、没有视频**（视频在电脑2 上，但电脑2 录的是
#   它们的偶数号项圈）。也就是说：**一只狗今天有没有视频，取决于它今天戴的是
#   单号还是双号项圈。**
#
#   想让每只狗每天都有视频，就按房间分而不是按单双号分——把两台的设备表换成
#   下面注释里那组（电脑1 拿 1/2/3 号房间的全部 6 个项圈，电脑2 拿
#   4/5/6 号房间的 6 个）。蓝牙还是各 6 路，摄像头还是 3+4，只是分法不同：
#
#     DEVICES="
#     9   DC:32:39:07:0A:3D  xiaobai      # 小白 比熊       1 号单间
#     10  CF:FA:72:BE:48:76  xiaobai      # 小白 比熊       1 号单间（另一个）
#     11  CB:DC:DC:40:3D:D1  keji         # 流浪柯基        2 号单间
#     12  E0:33:21:2C:4B:C2  keji         # 流浪柯基        2 号单间（另一个）
#     13  EF:8A:A6:65:3A:BC  xiaojinmao   # 流浪小金毛      3 号单间
#     14  DD:CB:D4:26:F9:55  xiaojinmao   # 流浪小金毛      3 号单间（另一个）
#     "
#   换的话记得连 PAIRS / KEEP_PAIRS 一起换（下面都标了）。
DEVICES="
9   DC:32:39:07:0A:3D  xiaobai      # 小白 比熊        1 号单间
11  CB:DC:DC:40:3D:D1  keji         # 流浪柯基         2 号单间
13  EF:8A:A6:65:3A:BC  xiaojinmao   # 流浪小金毛 金毛   3 号单间
15  CE:6E:61:15:B7:6E  wangcai      # 旺财 法斗        4 号单间（视频在电脑2）
17  F7:26:19:3A:AB:6F  dajinmao     # 大金毛 金毛      5 号单间（视频在电脑2）
19  E4:A5:52:E8:DC:7E  dongde       # 东德            6 号单间（视频在电脑2）
"

# 这台不设 DEVICES_STANDBY。偶数那组在电脑2 上录，两台加起来 12 个全覆盖，
# 不需要换班开关——USE_STANDBY / ALL_DEVICES 在这台上都用不着。

# ── 配对 ────────────────────────────────────────────────────────────────
# 只点这台机器有摄像头的那三间。15/17/19 没有对应机位，不写配对——写了
# record_multicam.sh 会提示"这几条配对的摄像头这次没开"并去掉，能跑但每次
# 刷三行警告。它们的 CSV 照样会录，走 KEEP_PAIRS 的 :csv 那几条。
PAIRS="cam1:imu9 cam2:imu11 cam3:imu13"

# 归档传 NAS 的清单。每路摄像头各点一次、每个设备各点一次。
# :csv = 只要这个设备的 CSV，不要那份视频（没有对应机位的三只狗就靠这个）。
KEEP_PAIRS="cam1_imu9 cam2_imu11 cam3_imu13 \
            cam1_imu15:csv cam1_imu17:csv cam1_imu19:csv"

# 两台电脑写**同一个**日期目录。camN 现在是全局唯一的机位号（电脑1 出
# cam1-3、电脑2 出 cam4-7），混在一个目录里也分得清，平台看到的还是一个狗场。
DAY_SUFFIX="_gouchang"

# 公用机位号（cleanup_gouchang.sh 读这个，不用每次手敲 --shared-cam）。
# 这台没有天花板那路（在电脑2 上）。清理脚本据此不去找 cam7。
SHARED_CAM="none"

CAPTURE_WIDTH="1280"
CAPTURE_HEIGHT="720"
EXTRA_ARGS="--no-save-overlay"
WARMUP_SEC="45"
OUT_DIR="data/multicam_multiimu"

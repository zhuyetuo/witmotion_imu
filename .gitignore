# setup_windows.sh 装出来的东西：miniconda、ffmpeg，以及下载的安装包缓存。
# 一台机器一份，跟着仓库走，删掉仓库等于卸载干净。不进版本库。
/.tools/

# 录制产物和日志。注意不能整个忽略 /data/——data/test 下有跟踪着的测试数据，
# 只忽略录制和归档实际写的那两个目录。
/data/multicam_multiimu/
/data/_upload/
/logs/

__pycache__/
*.pyc

# 这台机器是哪个场地（狗场 / 影棚）。每台机器自己一份，不进版本库——
# 进了的话每台都要改一次，而且 git pull 每次冲突。
#   echo 狗场 > sites/.current
/sites/.current
